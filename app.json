{
  "expo": {
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-asset"
    ],
    "name": "Fidel",
    "slug": "fidel",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "assets/**/*",
      "content/**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourorg.fidel",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yourorg.fidel"
    },
    "splash": {
      "backgroundColor": "#211A14"
    }
  }
}
